# Database Configuration (PostgreSQL 16)
POSTGRES_USER=qadevel
POSTGRES_PASSWORD=qapassword123
POSTGRES_DB=qa_platform_v2
DATABASE_URL=postgresql://qadevel:qapassword123@localhost:5432/qa_platform_v2

# Redis Queue Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Object Storage (MinIO S3)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=qa-artifacts
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# API Gateway & Dashboard
PORT=4000
API_URL=http://localhost:4000
DASHBOARD_URL=http://localhost:3000

# LLM Providers for Quality Copilot & Autonomous Web Agent
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here
OPENROUTER_MODEL=google/gemma-3-27b-it:free
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here
OPENAI_API_KEY=sk-proj-your_openai_key_here

# MCP Server Configuration
VERISHIP_MCP_PORT=8001
MCP_TRANSPORT=stdio

# Worker Engine Settings
HEADLESS=true
MAX_FULL_SNAPSHOTS=3
MAX_STEPS=15
JOB_TIMEOUT_MS=60000
